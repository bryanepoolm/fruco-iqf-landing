---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.vue";
import About from "../components/About.vue";
import Process from "../components/Process.vue";
import Advantages from "../components/Advantages.vue";
import PackagingGallery from "../components/PackagingGallery.vue";
import ContactForm from "../components/ContactForm.vue";
---

<Layout title="Fruco | Frutas Congeladas IQF">
	<main>
		<Hero client:load />
		<About client:visible />
		<Process client:visible />
		<Advantages client:visible />
		<PackagingGallery />
		<ContactForm client:visible />
	</main>

	<section class="bg-white py-12 border-t border-gray-100">
		<div class="max-w-5xl mx-auto px-4 text-center">
			<span
				class="text-sm text-gray-500 font-semibold tracking-wider uppercase mb-4 block"
				>Una empresa de</span
			>
			<img
				src="/assets/logro-grupo-arlugo.jpeg"
				alt="Grupo Arlugo"
				class="h-24 md:h-28 mx-auto object-contain opacity-90 hover:opacity-100 transition-opacity duration-300"
			/>
		</div>
	</section>

	<footer class="bg-fruco-green-dark text-white py-8 text-center">
		<p>
			&copy; {new Date().getFullYear()} Fruco IQF Corporation. Todos los derechos
			reservados.
		</p>
	</footer>
</Layout>
